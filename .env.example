DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/DATABASE_NAME
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Use false only for local HTTP development; production must use true over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Leave blank for host-only cookies, which is the safest default.
AUTH_COOKIE_DOMAIN=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
